{
  "name": "explicai-mcp",
  "version": "0.1.0",
  "description": "MCP server so an AI agent can build and export Explicaí manuals. Servidor MCP para o agente de IA montar e exportar manuais do Explicaí.",
  "license": "MIT",
  "author": "Gabriel Sampaio",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "explicai-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "explicai": ">=0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
